import 'dart:ui' as ui;

import 'package:dotdart_generated_consumer_fixture/gen/icons.g.dart';
import 'package:dotdart_generated_consumer_fixture/gen/images.g.dart';
import 'package:dotdart_generated_consumer_fixture/gen/lotties.g.dart';
import 'package:flutter/material.dart';
import 'package:flutter/rendering.dart' show RenderRepaintBoundary;
import 'package:flutter_test/flutter_test.dart';

void main() {
  group('dotdart generated consumer', () {
    setUp(() {
      imageCache
        ..clear()
        ..clearLiveImages();
    });

    for (final fileName in ['missing.svg', 'FIXTURE_ICON.svg', 'fixture_icon', 'assets/icons/fixture_icon.svg', '']) {
      test('when looking up "$fileName", it should return null', () {
        expect($Icons.findByName(fileName), isNull);
      });
    }

    final assets =
        <
          ({
            String fileName,
            Widget Function({Key? key, double? width, double? height}) direct,
            Widget? Function(String fileName, {Key? key, double? width, double? height}) lookup,
          })
        >[
          (fileName: 'drop_shadow.svg', direct: $Icons.dropShadow, lookup: $Icons.findByName),
          (fileName: 'fixture_icon.svg', direct: $Icons.fixtureIcon, lookup: $Icons.findByName),
          (fileName: 'lottie.json', direct: $Icons.lottie, lookup: $Icons.findByName),
          (fileName: 'photo.png', direct: $Icons.photo, lookup: $Icons.findByName),
          (fileName: 'fixture_animation.json', direct: $Lotties.fixtureAnimation, lookup: $Lotties.findByName),
          (fileName: 'landscape.png', direct: $Images.landscape, lookup: $Images.findByName),
          (fileName: 'portrait.png', direct: $Images.portrait, lookup: $Images.findByName),
          (fileName: 'animated.gif', direct: $Images.animated, lookup: $Images.findByName),
        ];
    for (final asset in assets) {
      for (final dimensions in <({double? width, double? height})>[
        (width: null, height: null),
        (width: 80, height: null),
        (width: null, height: 60),
        (width: 80, height: 60),
      ]) {
        testWidgets(
          'when looking up ${asset.fileName} at $dimensions, it should preserve the direct widget and layout',
          (tester) async {
            const directKey = ValueKey('direct');
            const lookupKey = ValueKey('lookup');
            final direct = asset.direct(key: directKey, width: dimensions.width, height: dimensions.height);
            final lookedUp = asset.lookup(
              asset.fileName,
              key: lookupKey,
              width: dimensions.width,
              height: dimensions.height,
            )!;
            await tester.pumpWidget(
              MaterialApp(
                home: SingleChildScrollView(child: Column(children: [direct, lookedUp])),
              ),
            );
            // Lookup retains automatic Lottie/GIF playback; sample a deliberate frame.
            await tester.pump(const Duration(milliseconds: 100));
            final directSize = tester.getSize(find.byWidget(direct));
            final lookupSize = tester.getSize(find.byWidget(lookedUp));

            expect(
              (lookedUp.runtimeType, lookedUp.key, lookupSize, lookupSize.isFinite, tester.takeException()),
              (direct.runtimeType, lookupKey, directSize, true, null),
            );
          },
        );
      }
    }

    testWidgets('when an exported drop shadow renders, it should preserve fill and paint outside the outline', (tester) async {
      final key = GlobalKey();
      await tester.pumpWidget(Directionality(
        textDirection: TextDirection.ltr,
        child: Center(child: RepaintBoundary(key: key, child: $Icons.dropShadow(width: 84))),
      ));
      await tester.pumpAndSettle();
      final boundary = key.currentContext!.findRenderObject()! as RenderRepaintBoundary;
      final (image, bytes) = await tester.runAsync(() async {
        final image = await boundary.toImage();
        return (image, await image.toByteData(format: ui.ImageByteFormat.rawRgba));
      }) ?? (throw StateError('Image capture failed'));
      final pixels = bytes!.buffer.asUint8List();
      final inside = (40 * image.width + 40) * 4;
      final outside = (64 * image.width + 40) * 4;
      final far = (75 * image.width + 40) * 4;
      expect(
        [pixels.sublist(inside, inside + 4), pixels[outside + 3], pixels[far + 3]],
        [[66, 197, 82, 255], greaterThan(0), 0],
      );
      image.dispose();
    });

    testWidgets('when shadow compositing meets transparency and siblings, it should preserve knockout and bounds', (tester) async {
      final key = GlobalKey();
      await tester.pumpWidget(Directionality(
        textDirection: TextDirection.ltr,
        child: Center(child: RepaintBoundary(key: key, child: $Icons.shadowComposite(width: 42))),
      ));
      await tester.pumpAndSettle();
      final boundary = key.currentContext!.findRenderObject()! as RenderRepaintBoundary;
      final (image, bytes) = await tester.runAsync(() async {
        final image = await boundary.toImage();
        return (image, await image.toByteData(format: ui.ImageByteFormat.rawRgba));
      }) ?? (throw StateError('Image capture failed'));
      final pixels = bytes!.buffer.asUint8List();
      final samples = [2, 20, 33, 35].map((x) {
        final offset = (20 * image.width + x) * 4;
        return pixels.sublist(offset, offset + 4);
      }).toList();
      expect(samples, [
        [255, 0, 0, 255],
        [closeTo(33, 1), closeTo(99, 1), closeTo(169, 1), 255],
        [0, 0, closeTo(82, 1), 255],
        [0, 0, 255, 255],
      ]);
      image.dispose();
    });

    testWidgets('when generated vector and image accessors render together, it should paint without errors', (
      tester,
    ) async {
      await tester.pumpWidget(
        MaterialApp(
          home: Column(
            children: [
              $Icons.fixtureIcon(width: 24),
              $Icons.lottie(width: 40, progress: 0.5),
              $Icons.photo(width: 24),
              $Lotties.fixtureAnimation(
                width: 40,
                progress: 0.5,
                clip: false,
                delay: Duration.zero,
                duration: const Duration(milliseconds: 500),
                playback: LottiePlayback.once,
              ),
              $Lotties.cataquiJobCardsCarousel(
                width: 120,
                progress: 0.5,
                overrides: const CataquiJobCardsCarouselOverrides(
                  jobCard01TextJobTitleText: 'Custom title',
                  jobCard02TextJobTitleText: 'Another title',
                  jobCard01TextPayTextColor: Colors.green,
                ),
              ),
              $Images.landscape(width: 80),
              $Images.portrait(height: 80),
              $Images.animated(width: 40),
            ],
          ),
        ),
      );
      await tester.pumpAndSettle();

      expect(tester.takeException(), isNull);
    });

    testWidgets('when a landscape image receives width only, it should preserve its two-to-one aspect ratio', (
      tester,
    ) async {
      await tester.pumpWidget(MaterialApp(home: $Images.landscape(width: 80)));

      final image = tester.widget<Image>(find.byType(Image));
      expect((image.width, image.height), equals((80, 40)));
    });

    testWidgets('when a portrait image receives height only, it should preserve its one-to-two aspect ratio', (
      tester,
    ) async {
      await tester.pumpWidget(MaterialApp(home: $Images.portrait(height: 80)));

      final image = tester.widget<Image>(find.byType(Image));
      expect((image.width, image.height), equals((40, 80)));
    });

    testWidgets('when different asset types share one folder, it should expose them from one namespace', (
      tester,
    ) async {
      await tester.pumpWidget(
        MaterialApp(
          home: Column(
            children: [
              $Icons.fixtureIcon(width: 24),
              $Icons.lottie(width: 40, progress: 0.5),
              $Icons.photo(width: 24),
            ],
          ),
        ),
      );
      await tester.pumpAndSettle();

      expect(tester.takeException(), isNull);
    });

    testWidgets('when generated circle and ellipse geometry renders, it should paint without errors', (tester) async {
      await tester.pumpWidget(MaterialApp(home: $Icons.ovalGeometry(width: 40)));
      await tester.pumpAndSettle();

      expect(tester.takeException(), isNull);
    });

    testWidgets('when generated matrix and skew geometry renders, it should preserve fills strokes and clips', (tester) async {
      const boundaryKey = ValueKey('affine_geometry_boundary');
      await tester.pumpWidget(Center(child: RepaintBoundary(
        key: boundaryKey, child: $Icons.affineGeometry(width: 100),
      )));
      await tester.pumpAndSettle();
      final boundary = tester.renderObject<RenderRepaintBoundary>(find.byKey(boundaryKey));
      final captured = await tester.runAsync(() async {
        final image = await boundary.toImage();
        final bytes = await image.toByteData(format: ui.ImageByteFormat.rawRgba);
        return (image, bytes);
      });
      final (image, bytes) = captured!;
      addTearDown(image.dispose);
      final pixels = bytes!.buffer.asUint8List();
      // Interior points calculated independently from the SVG coordinates.
      final samples = [(5, 5), (1, 1), (39, 6), (31, 6), (66, 10), (66, 2),
        (16, 38), (5, 38), (45, 34), (45, 37), (70, 36), (62, 36),
        (15, 64), (5, 64), (35, 65)];
      expect(samples.map((point) => pixels[(point.$2 * image.width + point.$1) * 4 + 3]),
        [255, 0, 255, 0, 255, 0, 255, 0, 255, 0, 255, 0, 255, 0, 0]);
    });

    testWidgets('when a generated SVG rotates a drawable, it should preserve the centered dumbbell connector', (
      tester,
    ) async {
      const boundaryKey = ValueKey('transformed_geometry_boundary');
      await tester.pumpWidget(
        Center(
          child: RepaintBoundary(
            key: boundaryKey,
            child: $Icons.transformedGeometry(width: 80),
          ),
        ),
      );
      await tester.pumpAndSettle();

      final boundary = tester.renderObject<RenderRepaintBoundary>(find.byKey(boundaryKey));
      final captured = await tester.runAsync(() async {
        final image = await boundary.toImage();
        final bytes = await image.toByteData(format: ui.ImageByteFormat.rawRgba);
        return (image, bytes);
      });
      final (image, bytes) = captured!;
      final pixels = bytes!.buffer.asUint8List();

      (int, int, int, int) pixelAt(int x, int y) {
        final offset = (y * image.width + x) * 4;
        return (pixels[offset], pixels[offset + 1], pixels[offset + 2], pixels[offset + 3]);
      }

      expect(
        (pixelAt(20, 20), pixelAt(20, 29)),
        equals(((0, 0, 0, 255), (0, 0, 0, 0))),
      );
    });

    testWidgets(
      'when a generated SVG has nested transformed and clipped groups, it should preserve rendered pixels',
      (tester) async {
        const boundaryKey = ValueKey('nested_groups_boundary');
        await tester.pumpWidget(
          MaterialApp(
            home: Center(
              child: RepaintBoundary(
                key: boundaryKey,
                child: $Icons.nestedGroups(
                  width: 40,
                  backgroundColor: Color(0xFF0000FF),
                  outlineColor: Color(0xFFFF0000),
                  innerTextColor: Color(0xFF00FF00),
                ),
              ),
            ),
          ),
        );
        await tester.pumpAndSettle();

        final boundary = tester.renderObject<RenderRepaintBoundary>(find.byKey(boundaryKey));
        final captured = await tester.runAsync(() async {
          final image = await boundary.toImage();
          final bytes = await image.toByteData(format: ui.ImageByteFormat.rawRgba);
          return (image, bytes);
        });
        final (image, bytes) = captured!;
        final pixels = bytes!.buffer.asUint8List();

        (int, int, int, int) pixelAt(int x, int y) {
          final offset = (y * image.width + x) * 4;
          return (pixels[offset], pixels[offset + 1], pixels[offset + 2], pixels[offset + 3]);
        }

        expect(
          (pixelAt(1, 1), pixelAt(6, 6), pixelAt(14, 14), pixelAt(26, 6)),
          equals(((0, 0, 255, 255), (255, 0, 0, 255), (128, 128, 0, 255), (0, 0, 255, 255))),
        );
      },
    );

    testWidgets('when a generated SVG has compound sibling paths, it should preserve both shapes and their holes', (
      tester,
    ) async {
      const boundaryKey = ValueKey('compound_wordmark_boundary');
      await tester.pumpWidget(
        Center(
          child: RepaintBoundary(
            key: boundaryKey,
            child: $Icons.compoundWordmark(width: 28, color1: const Color(0xFF5E5E5E)),
          ),
        ),
      );
      await tester.pumpAndSettle();

      final boundary = tester.renderObject<RenderRepaintBoundary>(find.byKey(boundaryKey));
      final captured = await tester.runAsync(() async {
        final image = await boundary.toImage();
        final bytes = await image.toByteData(format: ui.ImageByteFormat.rawRgba);
        return (image, bytes);
      });
      final (image, bytes) = captured!;
      final pixels = bytes!.buffer.asUint8List();

      (int, int, int, int) pixelAt(int x, int y) {
        final offset = (y * image.width + x) * 4;
        return (pixels[offset], pixels[offset + 1], pixels[offset + 2], pixels[offset + 3]);
      }

      expect(
        (pixelAt(1, 1), pixelAt(5, 5), pixelAt(17, 1), pixelAt(21, 5)),
        equals(((94, 94, 94, 255), (0, 0, 0, 0), (94, 94, 94, 255), (0, 0, 0, 0))),
      );
    });

    testWidgets('when precaching without dimensions, it should remove the widget-default entry', (tester) async {
      late BuildContext context;
      await tester.pumpWidget(
        MaterialApp(
          home: Builder(builder: (value) => SizedBox(key: ValueKey(context = value))),
        ),
      );

      await tester.runAsync(() => $ImagesCache.precacheLandscape(context));
      await tester.pump();

      expect(await $ImagesCache.removeLandscape(context), isTrue);
    });

    testWidgets('when removing a displayed image, it should preserve its live entry', (tester) async {
      late BuildContext context;
      await tester.pumpWidget(
        MaterialApp(
          home: Builder(
            builder: (value) {
              context = value;
              return $Images.landscape();
            },
          ),
        ),
      );
      await tester.pumpAndSettle();

      final image = tester.widget<Image>(find.byType(Image));
      final configuration = createLocalImageConfiguration(context);
      final key = await image.image.obtainKey(configuration);
      final removed = await $ImagesCache.removeLandscape(context);
      final status = imageCache.statusForKey(key);

      expect((removed, status.live, status.keepAlive), equals((true, true, false)));
    });

    testWidgets('when precaching an image by width, it should remove the derived-size entry', (tester) async {
      late BuildContext context;
      await tester.pumpWidget(
        MaterialApp(
          home: Builder(builder: (value) => SizedBox(key: ValueKey(context = value))),
        ),
      );

      await tester.runAsync(() => $ImagesCache.precacheLandscape(context, width: 80));
      await tester.pump();

      expect(await $ImagesCache.removeLandscape(context, width: 80), isTrue);
    });

    testWidgets('when precaching an image by height, it should remove the derived-size entry', (tester) async {
      late BuildContext context;
      await tester.pumpWidget(
        MaterialApp(
          home: Builder(builder: (value) => SizedBox(key: ValueKey(context = value))),
        ),
      );

      await tester.runAsync(() => $ImagesCache.precachePortrait(context, height: 80));
      await tester.pump();

      expect(await $ImagesCache.removePortrait(context, height: 80), isTrue);
    });

    testWidgets('when removing a different image size, it should preserve the matching cached entry', (tester) async {
      late BuildContext context;
      await tester.pumpWidget(
        MaterialApp(
          home: Builder(builder: (value) => SizedBox(key: ValueKey(context = value))),
        ),
      );

      await tester.runAsync(() => $ImagesCache.precacheLandscape(context, width: 80));
      await tester.pump();
      final removedDifferentSize = await $ImagesCache.removeLandscape(context, width: 40);
      final removedMatchingSize = await $ImagesCache.removeLandscape(context, width: 80);

      expect((removedDifferentSize, removedMatchingSize), equals((false, true)));
    });
  });
}
