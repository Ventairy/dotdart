import 'dart:ui' as ui;

import 'package:dotdart_generated_consumer_fixture/gen/icons.g.dart';
import 'package:flutter/rendering.dart' show RenderRepaintBoundary;
import 'package:flutter_test/flutter_test.dart';
import 'package:material_ui/material_ui.dart';

void main() {
  testWidgets(
    'when a patterned mask intersects its target and region, it should preserve all clips and group transforms',
    (tester) async {
      final key = GlobalKey();
      await tester.pumpWidget(
        MaterialApp(
          home: Center(
            child: RepaintBoundary(key: key, child: $Icons.maskedPatternIntersection(width: 100)),
          ),
        ),
      );
      await tester.pumpAndSettle();
      await tester.runAsync(() async {
        final deadline = DateTime.now().add(const Duration(seconds: 10));
        while (imageCache.pendingImageCount > 0) {
          if (DateTime.now().isAfter(deadline)) throw StateError('Pattern decode timed out.');
          await Future<void>.delayed(const Duration(milliseconds: 10));
        }
      });
      await tester.pumpAndSettle();
      final pixels = await tester.runAsync(() async {
        final boundary = key.currentContext!.findRenderObject()! as RenderRepaintBoundary;
        final image = await boundary.toImage();
        final bytes = (await image.toByteData(format: ui.ImageByteFormat.rawRgba))!;
        final pixels = [
          for (final (x, y) in [(10, 40), (30, 20), (70, 20), (30, 70), (70, 70), (30, 90), (83, 30)])
            [for (var channel = 0; channel < 4; channel++) bytes.getUint8((y * image.width + x) * 4 + channel)],
        ];
        image.dispose();
        return pixels;
      });
      expect(pixels, [
        [0, 255, 255, 255],
        [255, 0, 0, 255],
        [0, 0, 255, 255],
        [0, 255, 0, 255],
        [255, 255, 0, 255],
        [0, 255, 255, 255],
        [0, 255, 255, 255],
      ]);
    },
  );
}
