name: dotdart_generated_consumer_fixture
publish_to: none

environment:
  sdk: ">=3.14.0 <4.0.0"
  flutter: ">=3.50.0"

dependencies:
  flutter:
    sdk: flutter
  material_ui: ^1.9.0

dev_dependencies:
  build_runner: ^2.15.0
  dotdart:
    path: DOTDART_PACKAGE_PATH
  flutter_test:
    sdk: flutter

dotdart:
  output: lib/gen/
  svg:
    - assets/icons/
  lottie:
    - assets/icons/lottie.json
    - assets/lotties/
  image:
    - assets/icons/photo.png
    - assets/images/

flutter:
  assets:
    - assets/icons/
    - assets/images/
